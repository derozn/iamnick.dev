# iamnick.dev environment schema (varlock env-spec).
# This file is COMMITTED — it declares every env var, never values.
# Real values live in .env.local (gitignored) and Vercel project settings.
# Validate resolved env anytime with: pnpm env:check
# ---

# Madame Zara (the fortune-teller attraction, /api/fortune).
# Without a key the route streams a canned in-character Reading (stub mode);
# an INVALID key also falls back to canned Readings (and logs server-side).
# @sensitive @optional
ANTHROPIC_API_KEY=

# Force stub mode even with a key present (dev / headless verification).
# @optional
FORTUNE_STUB=

# Cross-instance rate limiting (refactor follow-on) — absent = per-instance
# in-memory limiter (rate-limiter-flexible RateLimiterMemory). A Redis/Upstash
# instance + a RateLimiterRedis swap in rateLimit.ts upgrades to shared counters.
# @sensitive @optional
UPSTASH_REDIS_REST_URL=
# @sensitive @optional
UPSTASH_REDIS_REST_TOKEN=

# Sentry (refactor Phase 7) — absent = no telemetry (init is gated on the DSN).
# Server errors read SENTRY_DSN at runtime; the browser SDK reads
# NEXT_PUBLIC_SENTRY_DSN at BUILD time (must be set in the deploy env to activate).
# @sensitive @optional
SENTRY_DSN=
# @optional
NEXT_PUBLIC_SENTRY_DSN=
