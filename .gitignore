*.tsbuildinfo

# Claude Code agent worktrees / local
.claude/worktrees/

# Playwright e2e (report + results are artifacts; snapshot baselines ARE committed)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# pnpm 11 (local + CI via packageManager) reads build approvals from
# `allowBuilds` here, but Vercel uses pnpm 9 which REJECTS a packages-less
# workspace file. So this stays untracked; pnpm 9 approvals live in
# package.json -> pnpm.onlyBuiltDependencies, and CI temp-writes this file.
pnpm-workspace.yaml
