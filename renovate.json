{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "timezone": "Europe/London",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "The R3F ecosystem must move together — three minor bumps routinely break @react-three/*.",
      "groupName": "react-three-fiber ecosystem",
      "matchPackageNames": ["three", "@types/three", "maath", "/^@react-three//"]
    },
    {
      "description": "Group the Vercel AI SDK packages.",
      "groupName": "vercel ai sdk",
      "matchPackageNames": ["ai", "/^@ai-sdk//"]
    },
    {
      "description": "Batch low-risk dev tooling.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "Auto-merge safe patch bumps once CI passes.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] }
}
